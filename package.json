{
  "name": "see-browse",
  "description": "Chrome extension that captures localhost page state for AI-assisted testing",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "wxt": "^0.19.0"
  }
}
